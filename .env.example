# Database
DATABASE_URL=postgres://user:password@host:port/dbname

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=some_random_secret_here

# Yandex OAuth (for user login)
YANDEX_CLIENT_ID=your_yandex_oauth_client_id
YANDEX_CLIENT_SECRET=your_yandex_oauth_client_secret

# Yandex Cloud (Infrastructure)
# Get Folder ID from Yandex Cloud Console (Overview page)
YC_FOLDER_ID=your_folder_id
# API Key for OCR and YandexGPT (created in Service Account -> API Keys)
YC_API_KEY=your_api_key

# Yandex Object Storage (S3)
# Static Access Keys created in Service Account -> Static Access Keys
YC_ACCESS_KEY_ID=your_access_key_id
YC_SECRET_ACCESS_KEY=your_secret_access_key
YC_BUCKET_NAME=autolog-docs
YC_S3_ENDPOINT=https://storage.yandexcloud.net

# Email Auth (Magic Links)
EMAIL_SERVER_USER=your_smtp_user
EMAIL_SERVER_PASSWORD=your_smtp_password
EMAIL_SERVER_HOST=smtp.yandex.ru
EMAIL_SERVER_PORT=465
EMAIL_FROM=noreply@yourdomain.ru
